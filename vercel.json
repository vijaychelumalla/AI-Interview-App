{
  "buildCommand": "cd ai-interview-frontend && npm install && npm run build",
  "outputDirectory": "ai-interview-frontend/build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-interview-app-jwd9.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
